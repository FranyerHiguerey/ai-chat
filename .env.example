# Which LLM provider to use: anthropic (default) or openai.
AI_CHAT_PROVIDER=anthropic

# The key for the provider above. Server-side only: never expose it to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional for anthropic (defaults to claude-haiku-5-5). Required for openai.
AI_CHAT_MODEL=

# Optional. Signs lead-capture webhook requests (HMAC).
AI_CHAT_LEAD_WEBHOOK_SECRET=
