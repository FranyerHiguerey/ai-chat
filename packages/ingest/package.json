{
  "name": "@franyerhiguerey/ai-chat-ingest",
  "version": "0.1.3",
  "description": "Turns uploaded files (md, txt, HTML, PDF, DOCX) into ai-chat knowledge documents",
  "keywords": [
    "chatbot",
    "pdf",
    "docx",
    "csv",
    "knowledge-base"
  ],
  "license": "MIT",
  "author": "Franyer Higuerey (https://github.com/FranyerHiguerey)",
  "homepage": "https://github.com/FranyerHiguerey/ai-chat/tree/main/packages/ingest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranyerHiguerey/ai-chat.git",
    "directory": "packages/ingest"
  },
  "bugs": {
    "url": "https://github.com/FranyerHiguerey/ai-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "mammoth": "*",
    "unpdf": "*"
  },
  "peerDependenciesMeta": {
    "mammoth": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mammoth": "^1.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "unpdf": "^1.9.1",
    "vitest": "^3.0.0"
  }
}
