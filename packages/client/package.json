{
  "name": "@franyerhiguerey/ai-chat-client",
  "version": "0.0.0",
  "description": "Browser client for ai-chat: streams replies from an ai-chat endpoint",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@franyerhiguerey/ai-chat-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@franyerhiguerey/ai-chat-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@franyerhiguerey/ai-chat-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
