{
  "name": "@franyerhiguerey/ai-chat-client",
  "version": "0.1.3",
  "description": "Browser client for ai-chat: streams replies from an ai-chat endpoint",
  "keywords": [
    "chatbot",
    "sse",
    "streaming",
    "browser"
  ],
  "license": "MIT",
  "author": "Franyer Higuerey (https://github.com/FranyerHiguerey)",
  "homepage": "https://github.com/FranyerHiguerey/ai-chat/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranyerHiguerey/ai-chat.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/FranyerHiguerey/ai-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@franyerhiguerey/ai-chat-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@franyerhiguerey/ai-chat-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@franyerhiguerey/ai-chat-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
