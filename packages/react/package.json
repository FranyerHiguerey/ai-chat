{
  "name": "@franyerhiguerey/ai-chat-react",
  "version": "0.1.1",
  "description": "React wrapper for the <ai-chat> widget",
  "keywords": [
    "chatbot",
    "react",
    "widget"
  ],
  "license": "MIT",
  "author": "Franyer Higuerey (https://github.com/FranyerHiguerey)",
  "homepage": "https://github.com/FranyerHiguerey/ai-chat/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranyerHiguerey/ai-chat.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/FranyerHiguerey/ai-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@franyerhiguerey/ai-chat-widget": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@franyerhiguerey/ai-chat-widget": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
