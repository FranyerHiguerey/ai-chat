{
  "name": "@franyerhiguerey/ai-chat-core",
  "version": "0.1.3",
  "description": "Server core for ai-chat: config, knowledge loading, prompt building and LLM calls (Claude or OpenAI)",
  "keywords": [
    "chatbot",
    "ai",
    "claude",
    "openai",
    "sse",
    "streaming",
    "rag"
  ],
  "license": "MIT",
  "author": "Franyer Higuerey (https://github.com/FranyerHiguerey)",
  "homepage": "https://github.com/FranyerHiguerey/ai-chat/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranyerHiguerey/ai-chat.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/FranyerHiguerey/ai-chat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live-check": "tsx --env-file-if-exists=../../.env scripts/live-check.ts"
  },
  "dependencies": {
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.43.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^22.10.0",
    "openai": "^7.43.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
